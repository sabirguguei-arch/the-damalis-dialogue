# Public contact configuration. Replace the placeholder with the administrator's
# international WhatsApp number using digits only, including the country code.
NEXT_PUBLIC_ADMIN_WHATSAPP_NUMBER=your_admin_whatsapp_number_here

# Server-side YouTube Data API v3 configuration. Never commit the real key.
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_SYNC_SECRET=your_random_revalidation_secret_here
